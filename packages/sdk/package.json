{
  "name": "@axonprotocol/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Axon — open-source agent-to-agent infrastructure",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "import": "./dist/evm.mjs",
      "require": "./dist/evm.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck",
    "test": "vitest run"
  },
  "keywords": [
    "axon",
    "ai",
    "agents",
    "sdk",
    "ethereum",
    "x402",
    "mcp"
  ],
  "license": "MIT",
  "author": "Axon",
  "homepage": "https://axon-agents.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeierkDev/Axon.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/SeierkDev/Axon/issues",
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "openai": "^6.49.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.0.0",
    "viem": "^2.56.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
